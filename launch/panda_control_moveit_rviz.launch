<?xml version="1.0" ?>
<launch>
  <!-- If needed, broadcast static tf for robot root -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="virtual_joint_broadcaster_1" args="0 0 0 0 0 0 world panda_link0" />

  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="load_gripper" default="false"/>
  <arg name="load_handle" default="false"/>
  <arg name="load_driller" default="false"/>
  <arg name="load_driller_new" default="false"/>
  <arg name="launch_rviz" default="true" />
  <arg name="launch_franka_control" default="true" />

  <include file="$(find franka_control)/launch/franka_control.launch" if="$(arg launch_franka_control)">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="load_gripper" value="$(arg load_gripper)"/>
  </include>

  <include file="$(find panda_moveit_config)/launch/panda_moveit.launch">
    <arg name="load_gripper" value="$(arg load_gripper)"/>
    <arg name="load_handle" value="$(arg load_handle)"/>
    <arg name="load_driller" value="$(arg load_driller)"/>
    <arg name="load_driller_new" value="$(arg load_driller_new)"/>
  </include>

  <include file="$(find panda_moveit_config)/launch/moveit_rviz.launch" if="$(arg launch_rviz)"/>
</launch>
